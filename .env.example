# ============================================================================
# Meta Graph API (Instagram Business Accounts -> Lectura de Publicaciones)
# ============================================================================
META_ACCESS_TOKEN=your_meta_graph_api_long_lived_token
META_GRAPH_API_VERSION=v25.0

# IDs de las cuentas de Instagram Business a sincronizar hacia X
IG_MN_AGENT_ID=17841400000000001
IG_MN_FEDERAL_ID=17841400000000002

# Opcional: Lista adicional de IDs separados por coma
# IG_ACCOUNT_IDS=17841400000000003,17841400000000004

# ============================================================================
# X (Twitter) API Credentials (OAuth 1.0a con permisos Read & Write)
# ============================================================================
TWITTER_API_KEY=your_twitter_api_key
TWITTER_API_SECRET=your_twitter_api_secret
TWITTER_ACCESS_TOKEN=your_twitter_access_token
TWITTER_ACCESS_SECRET=your_twitter_access_secret
