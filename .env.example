# Meta Graph API — Instagram API with Facebook Login
META_ACCESS_TOKEN=your_meta_access_token
META_GRAPH_API_VERSION=v25.0

# Al menos un ID numérico. Varias cuentas alimentan UNA cuenta de X.
IG_ACCOUNT_IDS=17841400000000001,17841400000000002
# Aliases opcionales del caso original (se deduplican):
# IG_MN_AGENT_ID=17841400000000001
# IG_MN_FEDERAL_ID=17841400000000002

# OAuth 1.0a de X: no se necesitan para dry-run.
TWITTER_API_KEY=your_x_api_key
TWITTER_API_SECRET=your_x_api_secret
TWITTER_ACCESS_TOKEN=your_x_access_token
TWITTER_ACCESS_SECRET=your_x_access_secret

# Inicio seguro para una configuración nueva. Cambiar a false habilita publicaciones.
DRY_RUN=true
