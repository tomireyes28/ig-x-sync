{
  "name": "ig-x-sync",
  "version": "1.0.0",
  "description": "Automated multi-account Instagram Business to X (Twitter) synchronization service built with TypeScript, Meta Graph API, and X API v1.1/v2.",
  "main": "dist/index.js",
  "scripts": {
    "dev": "ts-node src/index.ts",
    "dry-run": "ts-node src/index.ts --dry-run",
    "build": "tsc",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit"
  },
  "keywords": [
    "instagram",
    "meta-graph-api",
    "twitter",
    "x-api",
    "automation",
    "typescript",
    "social-media-sync"
  ],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "axios": "^1.15.2",
    "dotenv": "^17.4.2",
    "twitter-api-v2": "^1.29.0"
  },
  "devDependencies": {
    "@types/node": "^25.6.0",
    "nodemon": "^3.1.14",
    "ts-node": "^10.9.2",
    "typescript": "^6.0.3"
  }
}
