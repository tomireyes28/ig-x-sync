{
  "name": "ig-x-sync",
  "version": "1.0.0",
  "description": "Automated multi-account Instagram Business to X (Twitter) synchronization service built with TypeScript, Meta Graph API, and X API v1.1/v2.",
  "main": "dist/index.js",
  "engines": {
    "node": "^22.17.0 || ^24.0.0"
  },
  "scripts": {
    "dev": "ts-node src/index.ts",
    "dry-run": "ts-node src/index.ts --dry-run",
    "build": "tsc",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit",
    "test": "npm run build && node --test tests/*.test.cjs",
    "test:coverage": "npm run build && node --test --experimental-test-coverage --test-coverage-include=dist/** --test-coverage-lines=90 --test-coverage-branches=80 --test-coverage-functions=85 tests/*.test.cjs",
    "recover": "ts-node src/recover.ts",
    "demo": "ts-node src/demo.ts"
  },
  "keywords": [
    "instagram",
    "meta-graph-api",
    "twitter",
    "x-api",
    "automation",
    "typescript",
    "social-media-sync"
  ],
  "author": "tomireyes28",
  "license": "ISC",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/tomireyes28/ig-x-sync.git"
  },
  "homepage": "https://github.com/tomireyes28/ig-x-sync#readme",
  "dependencies": {
    "axios": "^1.21.1",
    "dotenv": "^17.4.2",
    "twitter-api-v2": "^1.29.0",
    "twitter-text": "^3.1.0"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "@types/twitter-text": "^3.1.10",
    "ts-node": "^10.9.2",
    "typescript": "^6.0.3"
  }
}
